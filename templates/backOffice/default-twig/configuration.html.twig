{# OpenApi module configuration fragment — rendered via module.configuration hook #}
<div class="card mb-3">
    <div class="card-header">
        <h5 class="card-title mb-0">{{ 'OpenAPI configurations'|trans({}, 'openapi.bo.default') }}</h5>
    </div>
    <div class="card-body">
        {{ form_start(form, {attr: {action: path('config_configuration_save'), method: 'POST'}}) }}

        {% if form.vars.errors|length > 0 %}
            <div class="alert alert-danger">
                {% for error in form.vars.errors %}{{ error.message }}{% endfor %}
            </div>
        {% endif %}

        <div class="col-md-4">
            <table class="table table-striped table-sm">
                <thead>
                    <tr>
                        <th>{{ 'Active'|trans({}, 'openapi.bo.default') }}</th>
                        <th>{{ 'Name'|trans({}, 'openapi.bo.default') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for config in configs %}
                        <tr>
                            <td>
                                <div class="form-check">
                                    <input
                                        type="checkbox"
                                        class="form-check-input"
                                        name="{{ form.enable_config.vars.full_name }}[{{ config.id }}]"
                                        value="{{ config.id }}"
                                        {% if config.id in enabled_configs %}checked{% endif %}
                                    >
                                </div>
                            </td>
                            <td>{{ config.name }}</td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="2" class="text-muted">{{ 'No configuration entry found.'|trans({}, 'openapi.bo.default') }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>

            {% do form.enable_config.setRendered %}
            {# Redirect targets after save/error — Thelia core hosts the module config page at /admin/module/<CODE> #}
            <input type="hidden" name="{{ form.success_url.vars.full_name }}" value="/admin/module/OpenApi">
            <input type="hidden" name="{{ form.error_url.vars.full_name }}" value="/admin/module/OpenApi">
            {% do form.success_url.setRendered %}
            {% do form.error_url.setRendered %}
            {{ form_rest(form) }}
        </div>

        <div class="mt-3">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-save"></i>
                {{ 'Save'|trans({}, 'openapi.bo.default') }}
            </button>
            <a href="{{ path('admin.module.list') }}" class="btn btn-secondary ms-2">
                {{ 'Close'|trans({}, 'openapi.bo.default') }}</a>
        </div>

        {{ form_end(form) }}
    </div>
</div>
